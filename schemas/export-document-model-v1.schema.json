{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fiction-lab-scenario-companion.local/schemas/export-document-model-v1.schema.json",
  "title": "Fiction Lab Scenario Companion ExportDocumentModel v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["modelVersion","generatedAt","profile","format","scenario","stateSummary","story","loreCards","connections","validation"],
  "properties": {
    "modelVersion": {"const":1},
    "generatedAt": {"type":"string","format":"date-time"},
    "profile": {"enum":["SCENARIO_ARCHITECT_REVIEW","FULL_DOCUMENTATION","HUMAN_REVIEW","SINGLE_CARD"]},
    "format": {"enum":["MARKDOWN","PDF"]},
    "options": {"$ref":"#/$defs/options"},
    "scenario": {"$ref":"#/$defs/scenario"},
    "stateSummary": {"$ref":"#/$defs/stateSummary"},
    "story": {"$ref":"#/$defs/story"},
    "loreCards": {"type":"array","items":{"$ref":"#/$defs/lore"}},
    "connections": {"type":"array","items":{"$ref":"#/$defs/connection"}},
    "validation": {"type":"array","items":{"$ref":"#/$defs/validation"}}
  },
  "$defs": {
    "options": {
      "type":"object","additionalProperties":false,
      "required":["includeMainDetails","includeStory","includeLoreCards","includeConnections","includeVisualCanonImages","includeVisualPrompts","includeCanonStatus","includeValidationDetails","includeInternalTimestamps"],
      "properties":{
        "includeMainDetails":{"type":"boolean"},"includeStory":{"type":"boolean"},"includeLoreCards":{"type":"boolean"},"includeConnections":{"type":"boolean"},
        "includeVisualCanonImages":{"type":"boolean"},"includeVisualPrompts":{"type":"boolean"},"includeCanonStatus":{"type":"boolean"},"includeValidationDetails":{"type":"boolean"},"includeInternalTimestamps":{"type":"boolean"}
      }
    },
    "scenario": {
      "type":"object","additionalProperties":false,
      "required":["id","name","description","status","tags"],
      "properties":{
        "id":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"coverImagePath":{"type":["string","null"]},"status":{"type":"string"},"tags":{"type":"array","items":{"type":"string"}},
        "createdAt":{"type":["string","null"]},"updatedAt":{"type":["string","null"]}
      }
    },
    "stateSummary": {
      "type":"object","additionalProperties":false,
      "required":["loreTotal","text","visual"],
      "properties":{
        "loreTotal":{"type":"integer","minimum":0},
        "text":{"type":"object","additionalProperties":false,"required":["open","draft","readyForPlatformCheck","canonClosed"],"properties":{"open":{"type":"integer","minimum":0},"draft":{"type":"integer","minimum":0},"readyForPlatformCheck":{"type":"integer","minimum":0},"canonClosed":{"type":"integer","minimum":0}}},
        "visual":{"type":"object","additionalProperties":false,"required":["notStarted","inProgress","visualCanon"],"properties":{"notStarted":{"type":"integer","minimum":0},"inProgress":{"type":"integer","minimum":0},"visualCanon":{"type":"integer","minimum":0}}}
      }
    },
    "story": {
      "type":"object","additionalProperties":false,"required":["backstory","greeting","customInstructions"],
      "properties":{"backstory":{"type":"string"},"greeting":{"type":"string"},"customInstructions":{"type":"string"}}
    },
    "prompt": {
      "type":"object","additionalProperties":false,"required":["type","sequence","title","prompt","notes"],
      "properties":{"type":{"enum":["CREATION","REFINEMENT"]},"sequence":{"type":"integer","minimum":0},"title":{"type":"string"},"prompt":{"type":"string"},"notes":{"type":"string"}}
    },
    "lore": {
      "type":"object","additionalProperties":false,
      "required":["id","displayOrder","title","type","internalCategory","description","content","weight","pinned","textCanonStatus","visualCanonStatus","triggers","traits","visualPrompts","outgoingConnectionIds","incomingConnectionIds"],
      "properties":{
        "id":{"type":"string"},"displayOrder":{"type":"integer","minimum":0},"title":{"type":"string"},"type":{"type":"string"},"internalCategory":{"type":"string"},"description":{"type":"string"},"content":{"type":"string"},"weight":{"type":"string"},"pinned":{"type":"boolean"},
        "textCanonStatus":{"type":"string"},"visualCanonStatus":{"type":"string"},"verifiedFictionLabCount":{"type":["integer","null"],"minimum":0},
        "triggers":{"type":"array","items":{"type":"string"}},"traits":{"type":"array","items":{"type":"string"}},
        "visualPrompts":{"type":"array","items":{"$ref":"#/$defs/prompt"}},"visualCanonImagePath":{"type":["string","null"]},
        "notes":{"type":["string","null"]},"createdAt":{"type":["string","null"]},"updatedAt":{"type":["string","null"]},
        "outgoingConnectionIds":{"type":"array","items":{"type":"string"}},"incomingConnectionIds":{"type":"array","items":{"type":"string"}}
      }
    },
    "connection": {
      "type":"object","additionalProperties":false,"required":["id","originCardId","originTitle","destinationCardId","destinationTitle","status","reason"],
      "properties":{"id":{"type":"string"},"originCardId":{"type":"string"},"originTitle":{"type":"string"},"destinationCardId":{"type":"string"},"destinationTitle":{"type":"string"},"status":{"type":"string"},"reason":{"type":"string"}}
    },
    "validation": {
      "type":"object","additionalProperties":false,"required":["severity","code","message"],
      "properties":{"severity":{"enum":["ERROR","WARNING","INFO"]},"code":{"type":"string"},"message":{"type":"string"},"entityType":{"type":["string","null"]},"entityId":{"type":["string","null"]}}
    }
  }
}
