{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fiction-lab-scenario-companion.local/schemas/backup-scenario-v1.schema.json",
  "title": "Fiction Lab Scenario Companion Backup Scenario v1",
  "description": "Versioned reconstruction contract stored as scenario.json inside a complete Companion backup ZIP. This is not a raw SQLite dump.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "backupFormatVersion",
    "applicationVersion",
    "createdAt",
    "scenario",
    "scenarioTags",
    "loreCards",
    "triggers",
    "characterTraits",
    "connections",
    "connectionEvents",
    "visualPrompts",
    "cardImages",
    "platformVerification"
  ],
  "properties": {
    "backupFormatVersion": {"const": 1},
    "applicationVersion": {"type": "string", "minLength": 1},
    "createdAt": {"$ref": "#/$defs/dateTime"},
    "scenario": {"$ref": "#/$defs/scenario"},
    "scenarioTags": {"type": "array", "items": {"$ref": "#/$defs/scenarioTag"}, "maxItems": 5},
    "loreCards": {"type": "array", "items": {"$ref": "#/$defs/loreCard"}},
    "triggers": {"type": "array", "items": {"$ref": "#/$defs/trigger"}},
    "characterTraits": {"type": "array", "items": {"$ref": "#/$defs/characterTrait"}},
    "connections": {"type": "array", "items": {"$ref": "#/$defs/connection"}},
    "connectionEvents": {"type": "array", "items": {"$ref": "#/$defs/connectionEvent"}},
    "visualPrompts": {"type": "array", "items": {"$ref": "#/$defs/visualPrompt"}},
    "cardImages": {"type": "array", "items": {"$ref": "#/$defs/cardImage"}},
    "platformVerification": {"type": "array", "items": {"$ref": "#/$defs/platformVerification"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "dateTime": {"type": ["string", "null"], "format": "date-time"},
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id","name","description","managedFolderName","status","backstory","greeting","customInstructions","notes","favorite","isTrashed","createdAt","updatedAt"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "coverImagePath": {"type": ["string", "null"]},
        "managedFolderName": {"type": "string", "minLength": 1},
        "status": {"enum": ["DRAFT","IN_DEVELOPMENT","READY_FOR_REVIEW","COMPLETE","ARCHIVED"]},
        "backstory": {"type": "string"},
        "greeting": {"type": "string"},
        "customInstructions": {"type": "string"},
        "notes": {"type": "string"},
        "favorite": {"type": "boolean"},
        "isTrashed": {"type": "boolean"},
        "trashedAt": {"$ref": "#/$defs/dateTime"},
        "createdAt": {"$ref": "#/$defs/dateTime"},
        "updatedAt": {"$ref": "#/$defs/dateTime"}
      }
    },
    "scenarioTag": {
      "type": "object", "additionalProperties": false,
      "required": ["id","scenarioId","value","displayOrder"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "scenarioId": {"$ref": "#/$defs/id"}, "value": {"type": "string", "minLength": 1}, "displayOrder": {"type": "integer", "minimum": 0}
      }
    },
    "loreCard": {
      "type": "object", "additionalProperties": false,
      "required": ["id","scenarioId","type","internalCategory","title","description","content","weight","pinned","textCanonStatus","visualCanonStatus","notes","revisionNote","sourceReferenceNote","displayOrder","isTrashed","createdAt","updatedAt"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "scenarioId": {"$ref": "#/$defs/id"},
        "type": {"enum": ["CHARACTER","LOCATION","PREMISE","FACTION","ITEM","RACE","RULE"]},
        "internalCategory": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1}, "description": {"type": "string"}, "content": {"type": "string"},
        "weight": {"enum": ["MINOR","SUPPLEMENTARY","STANDARD","IMPORTANT","CRITICAL"]},
        "pinned": {"type": "boolean"},
        "textCanonStatus": {"enum": ["OPEN","DRAFT","READY_FOR_PLATFORM_CHECK","CANON_CLOSED"]},
        "visualCanonStatus": {"enum": ["NOT_STARTED","IN_PROGRESS","VISUAL_CANON"]},
        "notes": {"type": "string"}, "revisionNote": {"type": "string"}, "sourceReferenceNote": {"type": "string"},
        "verifiedFictionLabCount": {"type": ["integer","null"], "minimum": 0},
        "displayOrder": {"type": "integer", "minimum": 0},
        "isTrashed": {"type": "boolean"}, "trashedAt": {"$ref": "#/$defs/dateTime"},
        "createdAt": {"$ref": "#/$defs/dateTime"}, "updatedAt": {"$ref": "#/$defs/dateTime"}
      }
    },
    "trigger": {
      "type": "object", "additionalProperties": false,
      "required": ["id","cardId","value","displayOrder"],
      "properties": {"id":{"$ref":"#/$defs/id"},"cardId":{"$ref":"#/$defs/id"},"value":{"type":"string","minLength":1},"displayOrder":{"type":"integer","minimum":0}}
    },
    "characterTrait": {
      "type": "object", "additionalProperties": false,
      "required": ["id","cardId","value","displayOrder"],
      "properties": {"id":{"$ref":"#/$defs/id"},"cardId":{"$ref":"#/$defs/id"},"value":{"type":"string","minLength":1},"displayOrder":{"type":"integer","minimum":0}}
    },
    "connection": {
      "type": "object", "additionalProperties": false,
      "required": ["id","scenarioId","originCardId","destinationCardId","status","reason","createdAt","updatedAt"],
      "properties": {
        "id":{"$ref":"#/$defs/id"},"scenarioId":{"$ref":"#/$defs/id"},"originCardId":{"$ref":"#/$defs/id"},"destinationCardId":{"$ref":"#/$defs/id"},
        "status":{"enum":["ACTIVE","DEFERRED","AFFECTED","INACTIVE"]},
        "reason":{"type":"string"},
        "previousStatus":{"type":["string","null"],"enum":["ACTIVE","DEFERRED","AFFECTED","INACTIVE",null]},
        "createdAt":{"$ref":"#/$defs/dateTime"},"updatedAt":{"$ref":"#/$defs/dateTime"}
      }
    },
    "connectionEvent": {
      "type":"object","additionalProperties":false,
      "required":["id","connectionId","eventType","createdAt"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"connectionId":{"$ref":"#/$defs/id"},
        "eventType":{"enum":["CREATED","STATUS_CHANGED","DIRECTION_REVERSED","REACTIVATED","DELETED"]},
        "previousValue":{"type":["string","null"]},"newValue":{"type":["string","null"]},"createdAt":{"$ref":"#/$defs/dateTime"}
      }
    },
    "visualPrompt": {
      "type":"object","additionalProperties":false,
      "required":["id","cardId","type","sequence","title","prompt","notes","createdAt","updatedAt"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"cardId":{"$ref":"#/$defs/id"},"type":{"enum":["CREATION","REFINEMENT"]},
        "sequence":{"type":"integer","minimum":0},"title":{"type":"string"},"prompt":{"type":"string","minLength":1},"notes":{"type":"string"},
        "createdAt":{"$ref":"#/$defs/dateTime"},"updatedAt":{"$ref":"#/$defs/dateTime"}
      }
    },
    "cardImage": {
      "type":"object","additionalProperties":false,
      "required":["id","cardId","managedPath","originalFilename","state","wasVisualCanon","createdAt","updatedAt"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"cardId":{"$ref":"#/$defs/id"},"managedPath":{"type":"string","minLength":1},"originalFilename":{"type":"string","minLength":1},
        "state":{"enum":["ACTIVE","ARCHIVED","MISSING"]},"wasVisualCanon":{"type":"boolean"},"archivedAt":{"$ref":"#/$defs/dateTime"},
        "createdAt":{"$ref":"#/$defs/dateTime"},"updatedAt":{"$ref":"#/$defs/dateTime"}
      }
    },
    "platformVerification": {
      "type":"object","additionalProperties":false,
      "required":["id","cardId","verifiedCount","accepted","notes","verifiedAt"],
      "properties":{
        "id":{"$ref":"#/$defs/id"},"cardId":{"$ref":"#/$defs/id"},"verifiedCount":{"type":"integer","minimum":0},"accepted":{"type":"boolean"},"notes":{"type":"string"},"verifiedAt":{"$ref":"#/$defs/dateTime"}
      }
    }
  }
}
